{
  "name": "frame-transform-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded rigid-frame editing with independent transform math, real WebGL geometry and a DOM/2D fallback",
  "type": "module",
  "license": "MIT",
  "author": "Lofrano Tecnologia",
  "homepage": "https://lofranotecnologia.com.br",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinlofranodeoliveira/frame-transform-studio"
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node scripts/check.mjs test",
    "build": "npm run typecheck && vite build && node scripts/check.mjs html",
    "preview": "vite preview --host 127.0.0.1",
    "demo": "node scripts/check.mjs demo"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@react-three/fiber": "9.8.2",
    "three": "0.184.0",
    "@react-three/drei": "10.7.9",
    "lucide-react": "1.69.0",
    "@fontsource/public-sans": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0"
  },
  "devDependencies": {
    "vite": "8.3.6",
    "@vitejs/plugin-react": "6.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "@react-three/test-renderer": "9.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.184.1",
    "typescript": "7.0.2",
    "@types/node": "22.20.5"
  }
}
